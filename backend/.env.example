# ==============================================================================
# ENV CLASSIFICATION LEGEND
# - OPS-CONTRACT-MANAGED: listed in src/modules/ops/ops-config-contract.ts and
#   visible in ops config overview APIs (some keys are immutable via ops API).
# - RUNTIME-ONLY: required by app/runtime but not managed via ops config routes.
#
# IMPORTANT:
# - This file is documentation/template only.
# - Running ops proposal/drift scripts is read-only and does not write DB/env.
# ==============================================================================

# Core runtime (mixed: some OPS-CONTRACT-MANAGED, some RUNTIME-ONLY)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
CLIENT_ID=ecomtemplate
BACKEND_PORT=3001

# Cart reservation TTL (minutes) — how long a hot-SKU reservation holds stock
CART_RESERVATION_TTL_MINUTES=20

# Load-shed mode override — normal | reduced | emergency (Redis override takes precedence)
LOAD_SHED_MODE=normal

# Verbose Ajv validation errors (dev only — never enable in production)
ENABLE_VERBOSE_VALIDATION_ERRORS=false

# Infrastructure — Docker Compose postgres service (RUNTIME-ONLY)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecom_template
POSTGRES_PORT=5432
# DATABASE_URL is bootstrap-only and must come from real environment before DB-backed Ops config can load.
# It must match the Postgres container credentials above.
# For Docker backend → postgres container: postgresql://postgres:postgres@postgres:5432/ecom_template
# For local dev (Node on host → Compose postgres): postgresql://postgres:postgres@localhost:5432/ecom_template
# IMPORTANT: URL-encode special characters in password (@ → %40, # → %23, etc)
# Example: password "Umesh@05" becomes "Umesh%4005" in the URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_template
# REDIS_URL is bootstrap-only for the initial Redis connection.
# Docker Compose (recommended on VPS): redis://:password@redis:6379
# Local (non-docker): override to redis://:password@localhost:6379 in your local .env
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
STOREFRONT_URL=https://client1.com
ADMIN_URL=https://client1.com
# In production-like profiles, both values are required and must be valid HTTPS origins.
# Same-origin storefront/admin deployments should keep these identical.

# Auth (RUNTIME-ONLY except where explicitly represented in ops contract)
JWT_SECRET=replace_with_64_char_secret
JWT_REFRESH_SECRET=replace_with_64_char_refresh_secret
# Cloudflare Turnstile (optional — leave empty to skip challenge verification)
TURNSTILE_SECRET_KEY=

# Strict production/test profiles (mixed)
# REPLAY_APPROVAL_TOKEN is OPS-CONTRACT-MANAGED and editable through Ops UI with ops:write + verified OTP.
REPLAY_APPROVAL_TOKEN=
# Replay audit trail retention (days) — ndjson entries older than this are pruned
REPLAY_AUDIT_RETENTION_DAYS=90

# Metrics scrape protection (OPS-CONTRACT-MANAGED)
# use IP allowlist and/or header token
OPS_METRICS_ALLOWLIST=
OPS_METRICS_TOKEN=

# Ops control plane
# OPS_API_KEY_SALT is DB-overlay eligible after restart.
OPS_API_KEY_SALT=replace_with_ops_api_key_salt
# OPS_DB_ENCRYPTION_KEY is bootstrap-only and never loaded from DB-backed Ops config.
OPS_DB_ENCRYPTION_KEY=replace_with_ops_db_encryption_key
OPS_DB_ENCRYPTION_KEY_VERSION=1
OPS_DUAL_APPROVAL_WINDOW_MINUTES=15
OPS_MFA_ENFORCE=true

# Redis key derivation (optional — defaults to JWT_SECRET for HMAC guest Redis keys e.g. coupon:guest-uses:v2)
REDIS_KEY_PEPPER=

# Webhook defense-in-depth (OPS-CONTRACT-MANAGED except TRUSTED_PROXY_ALLOWLIST_CIDR)
# empty = disabled. Comma-separated IPv4/IPv6 hosts or CIDRs.
RAZORPAY_WEBHOOK_ALLOWLIST_CIDR=
# Provider-agnostic shipping webhook IP allowlist (replaces DELHIVERY_WEBHOOK_ALLOWLIST_CIDR).
# Falls back to DELHIVERY_WEBHOOK_ALLOWLIST_CIDR for backward compatibility.
SHIPPING_WEBHOOK_ALLOWLIST_CIDR=
DELHIVERY_WEBHOOK_ALLOWLIST_CIDR=
TRUSTED_PROXY_ALLOWLIST_CIDR=
# When Razorpay sends top-level created_at (unix seconds), reject outside this window.
RAZORPAY_WEBHOOK_MAX_SKEW_SECONDS=300
# Shipping webhook occurredAt clock-skew window (seconds). Applies to both Delhivery and Shiprocket.
DELHIVERY_WEBHOOK_MAX_SKEW_SECONDS=300
SHIPROCKET_WEBHOOK_MAX_SKEW_SECONDS=300
HEALTH_QUEUE_STALE_WAITING_SECONDS=300

# Checkout risk — optional Redis velocity on POST /api/v1/payments/initiate per user/hour (RUNTIME-ONLY)
RISK_VELOCITY_ENABLED=false
RISK_PAYMENT_INIT_MAX_PER_HOUR=30

# Payment (OPS-CONTRACT-MANAGED)
# Provider keys below are bootstrap defaults and can be overridden via Ops DB config.
PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_FAILOVER_ENABLED=false
PAYMENT_CB_FAILURE_THRESHOLD=5
PAYMENT_CB_COOLDOWN_MS=30000
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Optional overlap while rotating RAZORPAY_WEBHOOK_SECRET (verify accepts either until old removed)
RAZORPAY_WEBHOOK_SECRET_OLD=

# Shipping (OPS-CONTRACT-MANAGED)
# Provider keys below are bootstrap defaults and can be overridden via Ops DB config.
# Set SHIPPING_PROVIDER=shiprocket to switch to Shiprocket; set =delhivery (default) for Delhivery.
SHIPPING_PROVIDER=delhivery
SHIPPING_PROVIDER_FAILOVER_ENABLED=false
SHIPPING_CB_FAILURE_THRESHOLD=5
SHIPPING_CB_COOLDOWN_MS=30000

# ── Delhivery (active when SHIPPING_PROVIDER=delhivery) ─────────────────────
DELHIVERY_API_KEY=replace_with_delhivery_token
DELHIVERY_BASE_URL=
DELHIVERY_WEBHOOK_TOKEN=
# Bootstrap fallback/default only. Admin can override at runtime via /api/v1/admin/settings/shipping.
DELHIVERY_PICKUP_PINCODE=522006

# ── Shiprocket (active when SHIPPING_PROVIDER=shiprocket) ───────────────────
# Create an API user in Shiprocket dashboard → Settings → API.
SHIPROCKET_EMAIL=replace_with_shiprocket_email
SHIPROCKET_PASSWORD=replace_with_shiprocket_password
# Webhook token — set in Shiprocket dashboard → Settings → API → Webhooks.
SHIPROCKET_WEBHOOK_TOKEN=
# Optional IP allowlist for Shiprocket webhook ingress (defense-in-depth).
SHIPROCKET_WEBHOOK_ALLOWLIST_CIDR=
# Bootstrap pickup pincode (admin can override at runtime).
SHIPROCKET_PICKUP_PINCODE=522006
# Override Shiprocket API base URL (leave empty to use default https://apiv2.shiprocket.in/v1/external)
SHIPROCKET_BASE_URL=

# Notifications (OPS-CONTRACT-MANAGED for NOTIFY_*/RESEND_*/MSG91_*/FAST2SMS_* keys)
# EMAIL_PROVIDER/SMS_PROVIDER/ADMIN_ALERT_EMAIL are runtime wiring values.
# SES remains planned-only in this template; runtime email provider is Resend.
# SMS template content is merchant-configurable from admin settings and stored in database.
# STORE_LEGAL_NAME is injected into SMS content as fallback when merchant store name is not set.
NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true
NOTIFY_WHATSAPP_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_with_resend_key
RESEND_FROM=Ecom Template <noreply@example.com>
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=replace_with_msg91_key
MSG91_SENDER_ID=ECOMTM
MSG91_ROUTE=4
FAST2SMS_API_KEY=replace_with_fast2sms_key
META_WHATSAPP_ACCESS_TOKEN=replace_with_meta_whatsapp_token
META_WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_meta_webhook_verify_token
META_WHATSAPP_APP_SECRET=replace_with_meta_app_secret
ADMIN_ALERT_EMAIL=admin@example.com

# Invoice document storage (RUNTIME-ONLY)
# Optional: defaults to ./storage/invoices when unset.
INVOICE_STORAGE_ROOT=/var/www/client/storage/invoices

# Seller profile (GST invoice fields) (RUNTIME-ONLY)
STORE_LEGAL_NAME=Ecom Store Pvt Ltd
STORE_SELLER_ADDRESS=Line 1, City, State
STORE_SELLER_STATE=Andhra Pradesh
STORE_SELLER_GSTIN=37ABCDE1234F1Z5
STORE_SELLER_FSSAI=12345678901234
# FSSAI validation trigger — set to 'food' or 'true' to require FSSAI license in invoice
STORE_REQUIRES_FSSAI=false
# Business type tag (used alongside STORE_REQUIRES_FSSAI)
STORE_BUSINESS_TYPE=general

# Feature flags (RUNTIME-ONLY)
FEATURE_COUPONS_ENABLED=false
FEATURE_REVIEWS_ENABLED=false
FEATURE_WISHLIST_ENABLED=false
FEATURE_GST_INVOICING_ENABLED=true
# Response envelope wraps all 2xx JSON responses in { success, data, meta? }
# Set to true when your frontend expects the standardized envelope format.
FEATURE_RESPONSE_ENVELOPE_ENABLED=false

# Admin IAM hardening (mixed)
# ADMIN_MFA_ENCRYPTION_KEY is OPS-CONTRACT-MANAGED and editable through Ops UI with ops:write + verified OTP.
ADMIN_MFA_ENFORCE=false
ADMIN_MFA_ENCRYPTION_KEY=replace_with_strong_admin_mfa_key
# Override default admin permissions (comma-separated, see src/common/auth/admin-permissions.ts)
ADMIN_DEFAULT_PERMISSIONS=
# Set to false + ALLOW_ADMIN_SCOPE_BYPASS=true in dev to skip permission enforcement
ADMIN_SCOPE_ENFORCEMENT=true
ALLOW_ADMIN_SCOPE_BYPASS=false

# Audit tamper-evident chain anchor (RUNTIME-ONLY)
AUDIT_ANCHOR_SECRET=replace_with_audit_anchor_secret

# ── Flash-sale / hot SKU admission control (RUNTIME-ONLY) ───────────────────
# Comma-separated variant UUIDs that trigger admission control (rate-limiting,
# per-user caps, cooldowns, sharded budget). Leave empty to disable.
# Use `node scripts/seed-flash-sale-fixtures.js` to generate test fixtures.
HOT_SKU_VARIANT_IDS=
# Per-minute admission budget per shard (total budget = this × HOT_SKU_SHARD_COUNT)
HOT_SKU_ADMISSION_BUDGET_PER_MINUTE=120
# Max units a single user can reserve across all hot SKUs
HOT_SKU_USER_RESERVE_CAP=2
# Cooldown seconds between successive hot-SKU reservations per user
HOT_SKU_COOLDOWN_SECONDS=15
# Number of Redis shards for admission budget keys. Increase if
# flash_sale_shard_contention_ratio histogram shows values consistently >0.85.
# Guideline: 4 for <500 concurrent users, 8 for 500-2k, 16 for 2k+.
HOT_SKU_SHARD_COUNT=8

# Idempotency scope HMAC secret (optional — falls back to JWT_SECRET) (RUNTIME-ONLY)
IDEMPOTENCY_SCOPE_SECRET=

# ── OpenTelemetry tracing (RUNTIME-ONLY) ─────────────────────────────────────
OTEL_TRACING_ENABLED=false
# Optional: service name for OTLP resource attributes (default: ecom-backend)
OTEL_SERVICE_NAME=ecom-backend
# Base OTLP endpoint (used for all signals unless overridden per-signal)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Optional: override just the traces endpoint (takes precedence over the base)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional: comma-separated key=value headers for authenticated collectors
# Example for Grafana Cloud: Authorization=Basic <base64>,X-Scope-OrgID=123456
# Example for Honeycomb:     x-honeycomb-team=your-api-key
# Example for Datadog:       DD-API-KEY=your-datadog-api-key
OTEL_EXPORTER_OTLP_HEADERS=

# ── Reconciliation worker auto-heal controls (RUNTIME-ONLY) ──────────────────
# Comma-separated list of issue types the reconciliation worker is allowed to
# auto-heal. Omit (or leave unset) to enable all four safe types:
#   PAYMENT_CAPTURED_ORDER_NOT_CONFIRMED
#   REFUNDED_STATUS_MISMATCH
#   STALE_PENDING_PAYMENT
#   ORDER_SHIPPED_WITHOUT_SHIPMENT
# Set to an empty string to disable ALL auto-heals (manual review only) —
# useful during fraud investigations or incident triage without a code deploy.
# Example (partial): RECONCILIATION_AUTO_HEAL_ISSUES=STALE_PENDING_PAYMENT,REFUNDED_STATUS_MISMATCH
RECONCILIATION_AUTO_HEAL_ISSUES=
